{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed:dev": "tsc -p tsconfig.seed.json && node dist/seed/prisma/seed-dev.js",
    "db:passwords:dev": "pnpm --filter @gossip/shared build && tsc -p tsconfig.seed.json && node dist/seed/prisma/set-dev-passwords.js",
    "db:subscription:dev": "tsc -p tsconfig.seed.json && node dist/seed/prisma/seed-subscription-dev.js"
  },
  "dependencies": {
    "@gossip/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prisma": "7.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
