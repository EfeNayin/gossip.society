generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Keep these enum values in sync with userRoleSchema / userStatusSchema in
// packages/shared (src/user/enum-parity.spec.ts fails when they drift).
enum UserRole {
  ADMIN
  VENUE_OWNER
  VENUE_STAFF
  INFLUENCER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

// Rules the database does NOT enforce (the services/guards that will own them
// are not built yet, so nothing checks them today):
// - role consistency: only INFLUENCER users should have an InfluencerProfile,
//   only VENUE_OWNER users should own a Venue, and only VENUE_STAFF users
//   should have VenueStaff rows;
// - an INFLUENCER user is not guaranteed to have a profile;
// - emails are unique, and a CHECK constraint (added by hand in the migration)
//   requires them to be lowercase, so callers must normalize before writing.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  // Nullable until the auth task; seed users keep it null.
  passwordHash String?
  role         UserRole
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  influencerProfile     InfluencerProfile?
  ownedVenues           Venue[]
  venueStaff            VenueStaff[]
  authSessions          AuthSession[]
  suspendedOffers       Offer[]
  idempotencyKeys       IdempotencyKey[]
  // The collaborations this user applied for (as an influencer), the ones this
  // user decided (as a venue owner) and the history entries this user wrote.
  collaborations        Collaboration[]      @relation("CollaborationInfluencer")
  decidedCollaborations Collaboration[]      @relation("CollaborationDecider")
  collaborationEvents   CollaborationEvent[]
}

model InfluencerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city              String
  bio               String?
  // Self-reported handle; not verified until the Instagram integration.
  instagramUsername String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Venue {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  // Exactly one owner per venue for now; one owner may manage many venues.
  ownerId        String          @db.Uuid
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       VenueBranch[]
  subscriptions  Subscription[]
  collaborations Collaboration[]

  @@index([ownerId])
}

// No location column yet: geographic search and map indexes come later.
model VenueBranch {
  id        String       @id @default(uuid()) @db.Uuid
  venueId   String       @db.Uuid
  venue     Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  city      String
  address   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  staff     VenueStaff[]
  offers    Offer[]

  @@index([venueId])
}

model VenueStaff {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String      @db.Uuid
  branch    VenueBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

// One row per successful login. The absolute expiry is fixed at creation and
// never extended by refreshing. revokedAt is set by logout, refresh-token
// reuse detection, or a refresh by an account that is no longer ACTIVE.
model AuthSession {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  // Written on every refresh. The conditional UPDATE also locks the session
  // row, which serializes refresh against logout and against other refreshes.
  lastRefreshedAt DateTime?
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

// Only the SHA-256 hash of the opaque token is stored. A token is consumed
// (usedAt) when exchanged; consumed rows are kept until the session is deleted
// so that presenting an old token again is detected as reuse. The migration
// adds a partial unique index (hand-written, Prisma can't express it) allowing
// at most one unused token per session.
model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  createdAt DateTime    @default(now())
  usedAt    DateTime?

  @@index([sessionId])
}

// An editable subscription package. The real prices and quotas are not decided
// yet, so nothing here is hard-coded and there is no price column.
model SubscriptionPlan {
  id                String         @id @default(uuid()) @db.Uuid
  name              String         @unique
  // Offers a venue may have PUBLISHED and not yet expired at the same time.
  activeOfferQuota  Int
  // Reserved for the application/approval task; not enforced anywhere yet.
  monthlyMatchQuota Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]
}

// A venue's subscription for one period, [startsAt, endsAt) in UTC. The
// migration adds (by hand, Prisma can't express them) an exclusion constraint
// so the periods of one venue never overlap, and a CHECK that endsAt > startsAt.
model Subscription {
  id        String           @id @default(uuid()) @db.Uuid
  venueId   String           @db.Uuid
  venue     Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  planId    String           @db.Uuid
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([venueId, startsAt, endsAt])
  @@index([planId])
}

// Keep these values in sync with offerStatusSchema in packages/shared.
enum OfferStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

// A collaboration offer of a venue branch. The venue (and so the owner) is
// reached through the branch; there is no duplicated venueId/ownerId. Money is
// an integer number of kuruş, times are UTC. The migration adds CHECK
// constraints for the value rules and the status/publish/suspension fields.
model Offer {
  id                 String      @id @default(uuid()) @db.Uuid
  branchId           String      @db.Uuid
  branch             VenueBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  title              String
  description        String
  serviceDescription String
  serviceValueKurus  Int
  expectedContent    String
  minFollowers       Int         @default(0)
  capacity           Int
  validFrom          DateTime
  validUntil         DateTime
  status             OfferStatus @default(DRAFT)
  publishedAt        DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?
  suspendedById      String?     @db.Uuid
  suspendedBy        User?       @relation(fields: [suspendedById], references: [id], onDelete: Restrict)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  idempotencyKeys IdempotencyKey[]
  collaborations  Collaboration[]

  @@index([branchId, createdAt])
  @@index([status, validUntil])
}

// Makes a create request safe to repeat. The client sends an Idempotency-Key
// header; the key, the user and the operation are unique together, and the row
// is written in the SAME transaction as the offer it created (both commit or
// neither does). `requestHash` is the SHA-256 of the normalized request body:
// the same key with another body is a conflict, never a second offer. Rows are
// kept until `expiresAt`; expired rows are treated as absent and deleted by
// later creates (no timer, no memory: the database is the only protection).
// The migration adds CHECK constraints by hand (key and hash length, expiry).
model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the key was used for, e.g. "offer.create". Keys of different
  // operations never collide.
  operation   String
  key         String
  requestHash String
  offerId     String   @db.Uuid
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([userId, operation, key])
  @@index([expiresAt])
  @@index([offerId])
}

// Keep these values in sync with collaborationStatusSchema in packages/shared.
// Only the states this task implements; the later states of the plan
// (SCHEDULED, CHECKED_IN, ...) are added by the tasks that build them.
enum CollaborationStatus {
  APPLIED
  APPROVED
  REJECTED
}

// An influencer's application to an offer and what the venue decided. The state
// changes ONLY through CollaborationService, which writes the row and its
// CollaborationEvent in one transaction.
//
// - One application per (offer, influencer), ever: the unique index is what
//   stops concurrent applications, and a rejected influencer can't re-apply.
// - `venueId` repeats the offer's venue so the monthly quota can be counted
//   with one indexed query. It is set by the service when the row is created
//   (an offer never changes venue).
// - `approvedAt` is the permanent basis of the monthly quota: it is written
//   once, on approval, and a later cancellation (a later task) must NOT clear
//   it, so cancelling never gives a match back by itself. Capacity, in
//   contrast, counts the collaborations that are approved NOW.
// - `termsSnapshot` is built on the server from the offer at the moment of the
//   application (never from what the client sent); `termsAcceptedAt` is when the
//   influencer accepted them.
// The migration adds CHECK constraints by hand (status/field consistency and
// the allowed transitions of the history).
model Collaboration {
  id              String               @id @default(uuid()) @db.Uuid
  offerId         String               @db.Uuid
  offer           Offer                @relation(fields: [offerId], references: [id], onDelete: Restrict)
  influencerId    String               @db.Uuid
  influencer      User                 @relation("CollaborationInfluencer", fields: [influencerId], references: [id], onDelete: Restrict)
  venueId         String               @db.Uuid
  venue           Venue                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  status          CollaborationStatus  @default(APPLIED)
  appliedAt       DateTime
  termsAcceptedAt DateTime
  termsSnapshot   Json
  decidedAt       DateTime?
  decidedById     String?              @db.Uuid
  decidedBy       User?                @relation("CollaborationDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  events          CollaborationEvent[]

  @@unique([offerId, influencerId])
  @@index([venueId, approvedAt])
  @@index([venueId, appliedAt])
  @@index([offerId, status])
  @@index([influencerId, appliedAt])
}

// Every creation and every state change of a collaboration, with who did it.
// The first entry of a collaboration has no previous status.
model CollaborationEvent {
  id              String               @id @default(uuid()) @db.Uuid
  collaborationId String               @db.Uuid
  collaboration   Collaboration        @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  fromStatus      CollaborationStatus?
  toStatus        CollaborationStatus
  actorId         String               @db.Uuid
  actor           User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())

  @@index([collaborationId, createdAt])
}
