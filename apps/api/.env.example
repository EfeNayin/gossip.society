PORT=3000
DATABASE_URL=postgresql://gossip:gossip@localhost:5432/gossip
# Comma-separated origins allowed by CORS (admin, Expo web)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
# Required, at least 32 characters, never committed. Generate one (Mac and Windows):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds; clients renew it with POST /auth/refresh.
JWT_ACCESS_TTL_SECONDS=900
# Absolute session length in seconds (7 days). Refreshing never extends it, so
# users must log in again after this; keep it >= JWT_ACCESS_TTL_SECONDS.
SESSION_TTL_SECONDS=604800
# Max login attempts per client IP within the window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Max refresh requests per client IP within the window.
REFRESH_RATE_LIMIT=20
REFRESH_RATE_WINDOW_SECONDS=60
