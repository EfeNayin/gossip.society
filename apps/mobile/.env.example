# API address as seen from the device running the app:
#   browser preview / iOS simulator   http://localhost:3000
#   Android emulator                  http://10.0.2.2:3000
#   physical phone (Expo Go)          the computer's LAN IP, e.g. http://192.168.1.10:3000
# Restart Expo after changing it (EXPO_PUBLIC_* values are bundled at build time).
EXPO_PUBLIC_API_URL=http://localhost:3000
